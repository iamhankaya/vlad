{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["roots", "ignore", "defaultAutonomy", "staleAfterHours", "launcher", "worktreeDir", "projects"],
  "properties": {
    "roots": { "type": "array", "items": { "type": "string" } },
    "ignore": { "type": "array", "items": { "type": "string" } },
    "defaultAutonomy": { "enum": ["plan", "commit", "pr"] },
    "staleAfterHours": { "type": "number", "exclusiveMinimum": 0 },
    "workerSilentMinutes": { "type": "number", "exclusiveMinimum": 0 },
    "maxParallel": { "type": "integer", "minimum": 1 },
    "launcher": { "enum": ["auto", "wt", "powershell", "cloud", "tmux", "terminal"] },
    "worktreeDir": { "type": "string" },
    "cloudKb": { "enum": ["readonly", "inline"] },
    "experiments": { "type": "object", "additionalProperties": false, "properties": { "ponytail": { "enum": ["ab"] } } },
    "workerAutoCompact": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?[kKmM]?)?$" },
    "memoryDirs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "kbDir": { "type": "string", "minLength": 1 },
    "brain": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "consoles": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } } } },
    "machines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "os", "agent"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "os": { "enum": ["win32", "darwin", "linux"] },
          "agent": {
            "type": "object",
            "additionalProperties": false,
            "required": ["port"],
            "properties": {
              "host": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$" },
              "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
              "bind": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$" }
            }
          },
          "maxParallel": { "type": "integer", "minimum": 1 },
          "worktreeDir": { "type": "string", "minLength": 1 },
          "roots": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "kbDir": { "type": "string", "minLength": 1 }
        }
      }
    },
    "projects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "autonomy": { "enum": ["plan", "commit", "pr"] } }
      }
    }
  }
}
