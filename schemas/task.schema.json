{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "project", "title", "kind", "state", "autonomy", "created", "updated"],
  "if": { "properties": { "model": { "const": "opus" } }, "required": ["model"] },
  "then": { "required": ["model_reason"], "properties": { "model_reason": { "type": "string", "minLength": 1 } } },
  "properties": {
    "id": { "type": "string", "pattern": "^T\\d{8}-\\d{2,}$" },
    "project": { "type": "string" },
    "title": { "type": "string" },
    "kind": { "enum": ["dev", "research", "pipeline"] },
    "state": { "enum": ["queued", "running", "blocked", "stalled", "awaiting_approval", "done", "failed", "cancelled"] },
    "autonomy": { "enum": ["plan", "commit", "pr"] },
    "branch": { "type": ["string", "null"] },
    "worktree": { "type": ["string", "null"] },
    "session_id": { "type": ["string", "null"] },
    "created": { "type": "string", "format": "date-time" },
    "updated": { "type": "string", "format": "date-time" },
    "error": { "type": ["string", "null"] },
    "digested": { "type": ["string", "null"], "format": "date-time" },
    "role": { "type": ["string", "null"] },
    "parent": { "type": ["string", "null"], "pattern": "^T\\d{8}-\\d{2,}$" },
    "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^T\\d{8}-\\d{2,}$" } },
    "phase": { "type": ["string", "null"] },
    "report_file": { "type": ["string", "null"] },
    "model": { "enum": ["haiku", "sonnet", "opus", null] },
    "model_reason": { "type": ["string", "null"] },
    "machine": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*$" },
    "machine_reserved": { "type": ["string", "null"], "format": "date-time" },
    "launch_op": { "type": ["string", "null"], "minLength": 1 },
    "released_ops": {
      "type": ["array", "null"],
      "items": { "type": "object", "required": ["machine", "op"], "additionalProperties": false, "properties": { "machine": { "type": "string", "minLength": 1 }, "op": { "type": "string", "minLength": 1 } } }
    }
  }
}
