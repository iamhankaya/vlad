{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "project", "title", "kind", "state", "autonomy", "created", "updated"],
  "properties": {
    "id": { "type": "string", "pattern": "^T\\d{8}-\\d{2,}$" },
    "project": { "type": "string" },
    "title": { "type": "string" },
    "kind": { "enum": ["dev", "research", "pipeline"] },
    "state": { "enum": ["queued", "running", "blocked", "stalled", "awaiting_approval", "done", "failed", "cancelled"] },
    "autonomy": { "enum": ["plan", "commit", "pr"] },
    "branch": { "type": ["string", "null"] },
    "worktree": { "type": ["string", "null"] },
    "session_id": { "type": ["string", "null"] },
    "created": { "type": "string", "format": "date-time" },
    "updated": { "type": "string", "format": "date-time" },
    "error": { "type": ["string", "null"] },
    "digested": { "type": ["string", "null"], "format": "date-time" },
    "role": { "type": ["string", "null"] },
    "parent": { "type": ["string", "null"], "pattern": "^T\\d{8}-\\d{2,}$" },
    "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^T\\d{8}-\\d{2,}$" } },
    "phase": { "type": ["string", "null"] }
  }
}
