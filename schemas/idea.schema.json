{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "project", "title", "state", "created", "updated"],
  "properties": {
    "id": { "type": "string", "pattern": "^I-[a-z0-9-]+-\\d{3,}$" },
    "project": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "state": { "enum": ["open", "promoted", "dropped"] },
    "source": { "type": ["string", "null"], "pattern": "^(T\\d{8}-\\d{2,}|F-[a-z0-9-]+-\\d+)$" },
    "promoted_task": { "type": ["string", "null"], "pattern": "^T\\d{8}-\\d{2,}$" },
    "created": { "type": "string", "format": "date-time" },
    "updated": { "type": "string", "format": "date-time" }
  }
}
