{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "project",
    "task",
    "state",
    "title",
    "options",
    "answer",
    "created",
    "updated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^C-\\d{8}-\\d{2,}$"
    },
    "kind": {
      "enum": [
        "ci_red",
        "conflict",
        "vlad_question",
        "action_request",
        "kb_conflict"
      ]
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "task": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^T\\d{8}-\\d{2,}$"
    },
    "state": {
      "enum": [
        "open",
        "resolved",
        "dismissed"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069]*$"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,40}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069]*$"
          }
        }
      },
      "maxItems": 8
    },
    "answer": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by_device",
            "at"
          ],
          "anyOf": [
            {
              "required": [
                "option"
              ]
            },
            {
              "required": [
                "text"
              ]
            }
          ],
          "properties": {
            "option": {
              "type": "string",
              "maxLength": 40
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069]*$"
            },
            "by_device": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,64}$"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "repo",
        "sha"
      ],
      "properties": {
        "kind": {
          "enum": [
            "merge_phase",
            "merge_final",
            "push",
            "tag"
          ]
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
        },
        "pr": {
          "type": "integer",
          "minimum": 1
        },
        "base": {
          "type": "string",
          "pattern": "^(?!-)(?!.*\\.\\.)[A-Za-z0-9._/-]{1,200}$"
        },
        "ref": {
          "type": "string",
          "pattern": "^(?!-)(?!.*\\.\\.)[A-Za-z0-9._/-]{1,200}$"
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "updated": {
      "type": "string",
      "format": "date-time"
    },
    "kb_conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "reason",
        "source",
        "head",
        "base",
        "paths"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "enum": [
            "merge_conflict",
            "rejected"
          ]
        },
        "source": {
          "enum": [
            "kbsync",
            "promote"
          ]
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "base": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "paths": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "enum": [
              "path_not_allowed",
              "dot_entry",
              "bad_segment",
              "windows_reserved",
              "case_collision",
              "path_too_long",
              "bad_extension",
              "symlink",
              "submodule",
              "mode",
              "rename",
              "delete_not_allowed",
              "too_large",
              "too_many_parents",
              "sensitive_field"
            ]
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "kind": {
        "const": "action_request"
      }
    }
  },
  "then": {
    "required": [
      "action"
    ],
    "properties": {
      "options": {
        "const": [
          {
            "id": "approve",
            "label": "Onayla"
          },
          {
            "id": "reject",
            "label": "Reddet"
          }
        ]
      }
    }
  },
  "else": {
    "not": {
      "required": [
        "action"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "kb_conflict"
          }
        }
      },
      "then": {
        "required": [
          "kb_conflict"
        ]
      },
      "else": {
        "not": {
          "required": [
            "kb_conflict"
          ]
        }
      }
    }
  ]
}
