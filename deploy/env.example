# /etc/vlad/vlad.env — şablon (install.sh yoksa oluşturur: root:vlad 0640).
# SIR YOK: yalnız yol ve ad. Anahtarlar/belgeler /var/lib/vladapi altında (vladapi 0600), PAT vlad kullanıcısının kendi gh girişinde durur.
# Systemd EnvironmentFile biçimi: KEY=değer, tırnaksız, satır sonu yorumu yok.

# --- VLAD (vlad, vladapi, vlad-kbsync, vlad-api) ---
# Kod kökü (root:root, ajan yazamaz; F-vlad-037). Yazılabilir tek alt klasör: $VLAD_HOME/state (vlad).
VLAD_HOME=/opt/vlad
# kb klonu (iamhankaya/vlad-kb). Birimlerdeki @KB_DIR@ buradan doldurulur.
VLAD_KB_DIR=/var/lib/vlad/kb
# Bu makinenin adı: etkin VLAD kaydı ve machines.<ad> üst yazımı bununla eşleşir.
VLAD_MACHINE=vlad-server

# --- kb topolojisi (vlad-kbpromote, vlad-api) ---
VLAD_KB_REPO=OWNER/vlad-kb
VLAD_KB_MAIN=main
VLAD_KB_SERVER_BRANCH=kb-server

# --- API (vlad-api) ---
VLAD_SERVER_HOST=127.0.0.1
VLAD_SERVER_PORT=8787
# Tailscale Funnel loopback'e proxy eder: 1 yalnız o zaman.
VLAD_SERVER_TRUST_PROXY=1
VLAD_SERVER_STATE_DIR=/var/lib/vladapi

# --- GitHub App "vlad-gate" (kimlik numaraları sır değildir; ÖZEL ANAHTAR dosyası /var/lib/vladapi/github-app.pem, 0600) ---
VLAD_GITHUB_APP_ID=
VLAD_GITHUB_APP_INSTALLATION_ID=
# İsteğe bağlı: anahtar başka yerdeyse mutlak yol (vladapi okuyabilmeli, kimse başkası okuyamamalı)
# VLAD_GITHUB_APP_KEY_FILE=/var/lib/vladapi/github-app.pem

# --- Sohbet ajanı (F-vlad-024) ---
# Boş bırakılırsa sohbet uçları 501 döner (güvenli varsayılan). Kurulumdan sonra: /usr/local/libexec/vlad/chat-client
VLAD_CHAT_CLIENT=
