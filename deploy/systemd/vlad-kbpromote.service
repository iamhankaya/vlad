[Unit]
Description=VLAD kb promote (validate kb-server, land it on vlad-kb main)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=vladapi
# VLAD_HOME, VLAD_KB_DIR, VLAD_KB_REPO, VLAD_KB_MAIN, VLAD_KB_SERVER_BRANCH, VLAD_GITHUB_APP_* come from here (written by the installer)
EnvironmentFile=-/etc/vlad/vlad.env
# promote runs git only in its own bare clone under /var/lib/vladapi (never in the agent's kb clone) and writes only through GithubWriter.pushKbMain
Environment=VLAD_SERVER_STATE_DIR=/var/lib/vladapi
ExecStart=/usr/bin/env vlad-server kb-promote
# a hung fetch or a hostile branch must not hold the unit (or the machine) for long
TimeoutStartSec=300
MemoryMax=512M
TasksMax=128
# promote reads the kb (VLAD_KB_DIR, group read; `vlad card` writes cards there) and writes its own state; nothing else
NoNewPrivileges=yes
ProtectSystem=strict
# the installer replaces @KB_DIR@ with the kb checkout (VLAD_KB_DIR): cards are written there through `vlad card`; nothing else outside the state dir is writable
ReadWritePaths=/var/lib/vladapi @KB_DIR@
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# same hardening block as vlad-api.service (promote holds the App token)
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
